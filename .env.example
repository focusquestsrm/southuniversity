# South University Landing Page - Environment Configuration
# Copy this file to .env and fill in actual values before deployment

# =========================================
# Lead Submission Settings
# =========================================
LEAD_SUBMISSION_ENABLED=false
LEAD_TEST_MODE=true

# =========================================
# LeadHoop Campaign Configuration
# =========================================
LEADHOOP_CAMPAIGN_CODE=avK3j_5CahaVgpJ4SicSQw
LEADHOOP_CAMPUS_ID=11776
LEADHOOP_MEDIA_TYPE=noncallcenter
LEADHOOP_POST_URL=http://back2learn-post.leadhoop.com/incoming/leads
LEADHOOP_PING_URL=http://back2learn-api.leadhoop.com/v1/pings

# =========================================
# External APIs & Services
# =========================================
# Google Maps API Key (for address autocomplete)
# Required for address autocomplete functionality
# Get from: https://cloud.google.com/docs/authentication/api-keys
GOOGLE_MAPS_BROWSER_KEY=[PLACEHOLDER: Get from Google Cloud Console]

# Google Analytics Tracking ID
# Format: G-XXXXXXXXXX (GA4) or UA-XXXXXXXXX (Universal Analytics)
# Get from: https://analytics.google.com
GOOGLE_ANALYTICS_ID=[PLACEHOLDER: Get from Google Analytics]

# Meta Pixel ID (Facebook Conversion Tracking)
# Format: Numeric ID
# Get from: https://business.facebook.com/
META_PIXEL_ID=[PLACEHOLDER: Get from Meta Business Manager]

# Jornaya LeadID Configuration
# Campaign ID for Jornaya lead attribution
# Get from: Your Jornaya account
JORNAYA_CAMPAIGN_ID=[PLACEHOLDER: Get from Jornaya]

# TrustedForm Key
# For TCPA compliance and consent tracking
# Get from: Your TrustedForm account
TRUSTEDFORM_KEY=[PLACEHOLDER: Get from TrustedForm]

# =========================================
# Email Validation Service
# =========================================
# Email validation provider and API key
# Options: zerobounce, kickbox, etc.
EMAIL_VALIDATION_SERVICE=[PLACEHOLDER: Email validation provider endpoint]
EMAIL_VALIDATION_API_KEY=[PLACEHOLDER: Email validation API key]

# =========================================
# Redirect URLs
# =========================================
# URL to redirect to after successful form submission
ACCEPTED_REDIRECT_URL=/thank-you

# URL to redirect to after form rejection or error
FAILED_REDIRECT_URL=/next-steps

# =========================================
# Legal & Compliance
# =========================================
# Privacy Policy URL
PRIVACY_POLICY_URL=[PLACEHOLDER: Privacy policy URL]

# Terms and Conditions URL
TERMS_CONDITIONS_URL=[PLACEHOLDER: Terms and conditions URL]

# =========================================
# Application Settings
# =========================================
# Node environment (development, production, test)
NODE_ENV=development

# Server port (for local development)
PORT=3000

# Server host
HOST=localhost

# =========================================
# Logging
# =========================================
# Log level (debug, info, warn, error)
LOG_LEVEL=info

# =========================================
# Database/Queue Storage (When Configured)
# =========================================
# Database connection string for storing leads
# Required for implementing lead queue and delivery scheduling
# Format depends on your chosen database (PostgreSQL, MongoDB, etc.)
DATABASE_URL=[PLACEHOLDER: Database connection URL - required for queue storage]

# Database credentials (if not in URL)
DB_USER=[PLACEHOLDER: Database user]
DB_PASSWORD=[PLACEHOLDER: Database password]
DB_NAME=south_university_leads

# =========================================
# Security
# =========================================
# CORS allowed origins (comma-separated)
CORS_ORIGINS=localhost:3000,https://your-domain.com

# API rate limiting (requests per minute)
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# =========================================
# Webhook Configuration (For Lead Delivery Notifications)
# =========================================
# Webhook URL to receive delivery status updates
WEBHOOK_URL=[PLACEHOLDER: Webhook endpoint for delivery status]
WEBHOOK_SECRET=[PLACEHOLDER: Webhook signing secret]

# =========================================
# Idempotency & Duplicate Prevention
# =========================================
# Enable idempotency checks to prevent duplicate submissions
ENABLE_IDEMPOTENCY=true

# Time window (in minutes) to check for duplicate leads
DUPLICATE_CHECK_WINDOW=60

# =========================================
# IMPORTANT SECURITY NOTES
# =========================================
# 1. NEVER commit actual secrets or API keys to Git
# 2. This file should be in .gitignore
# 3. Add real values only in your Netlify environment variables
# 4. Use separate configs for development, staging, and production
# 5. All credentials should be generated by authorized personnel only
# 6. Rotate API keys regularly
# 7. Use strong, unique passwords for all external services
# 8. Enable multi-factor authentication on all accounts
# 9. Store backups of secrets in a secure password manager
# 10. Audit access to sensitive data regularly
